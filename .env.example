# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_controller
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_controller

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Temporal Configuration
TEMPORAL_URL=localhost:7233

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Integration
# Switch between "test" and "live" modes here
RAZORPAY_MODE=test

# Razorpay Test Mode Keys
RAZORPAY_TEST_KEY_ID=your_test_key_id_here
RAZORPAY_TEST_KEY_SECRET=your_test_key_secret_here

# Razorpay Live Mode Keys
RAZORPAY_LIVE_KEY_ID=your_live_key_id_here
RAZORPAY_LIVE_KEY_SECRET=your_live_key_secret_here

# Webhook Secrets
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
